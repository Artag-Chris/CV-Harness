# Puerto HTTP del harness
PORT=3100

# PostgreSQL (docker-compose mapea el 5434 del host → 5432 del contenedor;
# 5433 lo ocupa el stack de atiende)
DATABASE_URL=postgresql://cvharness:cvharness@localhost:5434/cvharness

# Redis (host 6380 → contenedor 6379)
REDIS_URL=redis://localhost:6380

# Prefijo de colas BullMQ y streams (aisla entornos que compartan Redis)
QUEUE_PREFIX=cvharness

# IA principal: DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq queda como fallback opcional (LLM_PROVIDER=groq).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# auto | deepseek | groq | mock (auto usa deepseek si hay key, si no groq, si no mock)
LLM_PROVIDER=auto

# Embeddings (OpenAI, estilo atiende) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# auto | openai | mock (auto usa openai si hay key)
EMBEDDING_PROVIDER=auto

# API oficial de un portal para fuentes kind=API_JSON (ej. plantilla "Jooble").
# La fuente referencia la variable por nombre; la key no se guarda en la base.
JOOBLE_API_KEY=

# Auth del dashboard (usuario admin sembrado)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@cvharness.local
ADMIN_PASSWORD=admin1234

# Scheduler global: cada cuántos minutos corre el crawl-cycle que despacha fuentes vencidas
CRON_INTERVAL_MINUTES=15

# Score mínimo de match para generar hoja de vida y notificar
MATCH_MIN_SCORE=65

# Fuente de prueba local (nginx de docker-compose)
FIXTURE_BASE_URL=http://localhost:8090
