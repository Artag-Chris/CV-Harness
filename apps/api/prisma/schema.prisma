// CV Harness — esquema de datos
// postgres:16 · Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Perfil canónico (1..N perfiles). Los MD actuales se consolidan en el seed.
// ─────────────────────────────────────────────────────────────────────────────

model Profile {
  id        String   @id @default(cuid())
  name      String
  headline  String[]
  summary   String
  email     String?
  phone     String?
  location  String?
  languages Json     @default("[]")
  softSkills Json    @default("[]")
  isPrimary Boolean  @default(false)
  // Cron por perfil: cada cuántos minutos se corre la búsqueda de SUS fuentes.
  scheduleMinutes Int?
  nextRunAt       DateTime?
  // Idioma de postulación por defecto de sus HV: auto (idioma de la vacante) | es | en.
  applyLanguage   String   @default("auto")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences Experience[]
  education   Education[]
  projects    Project[]
  skills      ProfileSkill[]
  links       ContactLink[]
  sources     ProfileSource[]
  vacancies   Vacancy[]
  resumeDrafts ResumeDraft[]
  resumes     Resume[]
  vacancyProfiles VacancyProfile[]
  matches     MatchResult[]
  interviewPreps InterviewPrep[]

  @@index([isPrimary])
}

// ─────────────────────────────────────────────────────────────────────────────
// Hojas de vida cargadas desde el dashboard (indexadas en pgvector)
// ─────────────────────────────────────────────────────────────────────────────

enum ResumeStatus {
  PENDING
  EMBEDDING
  READY
  FAILED
}

enum ResumeKind {
  PDF
  MARKDOWN
  TEXT
}

model Resume {
  id        String       @id @default(cuid())
  profileId String
  name      String
  kind      ResumeKind
  filename  String? // nombre original si se subió un archivo
  rawText   String       @db.Text
  status    ResumeStatus @default(PENDING)
  error     String?
  active    Boolean      @default(false) // solo una activa por perfil (app-level)
  chunkCount Int         @default(0)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  profile Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  chunks  ResumeChunk[]

  @@index([profileId, active])
}

model ResumeChunk {
  id        String   @id @default(cuid())
  resumeId  String
  index     Int
  content   String   @db.Text
  // Vector de pgvector (text-embedding-3-small → 1536). Se escribe/lee con SQL
  // crudo ($executeRaw/$queryRaw) porque Prisma no lo tipa.
  embedding Unsupported("vector(1536)")?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, index])
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  role        String
  company     String
  periodStart String
  periodEnd   String?
  isCurrent   Boolean  @default(false)
  bullets     Json     @default("[]")
  sortOrder   Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Education {
  id          String @id @default(cuid())
  profileId   String
  institution String
  degree      String
  periodStart String
  periodEnd   String?
  sortOrder   Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id            String @id @default(cuid())
  profileId     String
  name          String
  summary       String
  stack         Json   @default("[]")
  repositoryUrl String?
  websiteUrl    String?
  visibility    String @default("public") // public | proprietary
  highlights    Json   @default("[]")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id            String          @id @default(cuid())
  name          String          @unique
  profileSkills ProfileSkill[]
}

model ProfileSkill {
  id         String @id @default(cuid())
  profileId  String
  skillId    String
  category   String // AI & LLMs, Backend, Frontend, Databases, Infra & Cloud...
  rating     Int // 1-5 (canónico, consolidado de los MDs)
  provenance String // Christian_Henao_AI_Engineer_CV.md | Christian_Henao_Skills_Formato.md | ... | curated
  knowledge  String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([category])
}

model ContactLink {
  id        String  @id @default(cuid())
  profileId String
  type      String // email | phone | github | linkedin | website | ...
  url       String
  isPrimary Boolean @default(false)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Fuentes de vacantes (lo que el cron recorre) + recetas de scraping
// ─────────────────────────────────────────────────────────────────────────────

model Source {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("HTML_RECIPE")
  baseUrl   String
  listUrl   String
  // Receta de selectores CSS y extracción (JSONB): { item, title, company,
  // location, description, applyUrl, postedAt, nextPage }
  selectors Json
  // Limites/politeness: { maxPages, delayMs, timeoutMs, userAgent, respectRobots }
  limits    Json     @default("{}")
  enabled   Boolean  @default(true)
  intervalMinutes Int @default(1440) // cadencia por defecto del sitio
  lastRunAt DateTime?
  nextRunAt DateTime  @default(now())

  // Los perfiles que vigilan este sitio (selección N:M).
  selections ProfileSource[]
  runs       ScrapeRun[]
  vacancies  Vacancy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, nextRunAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Selección perfil ↔ sitio: qué URLs guardadas vigila cada perfil y con qué
// cadencia propia. El cron del perfil recorre sus selecciones habilitadas.
// ─────────────────────────────────────────────────────────────────────────────

model ProfileSource {
  id        String   @id @default(cuid())
  profileId String
  sourceId  String
  enabled   Boolean  @default(true)
  // null → usa la cadencia del perfil (Profile.scheduleMinutes).
  intervalMinutes Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([profileId, sourceId])
  @@index([sourceId, enabled])
}

model ScrapeRun {
  id          String    @id @default(cuid())
  sourceId    String
  requestId   String    @unique
  status      String    @default("RUNNING") // RUNNING | OK | FAILED
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  itemsFound  Int       @default(0)
  itemsNew    Int       @default(0)
  error       String?

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Vacantes y pipeline de enriquecimiento
// ─────────────────────────────────────────────────────────────────────────────

enum VacancyStatus {
  RAW
  NORMALIZED
  MATCHED
  RESUME_READY
  APPLIED
  IGNORED
}

model Vacancy {
  id             String        @id @default(cuid())
  sourceId       String
  profileId      String?
  fingerprint    String        @unique // sha256(url canónica)
  externalId     String?
  url            String
  title          String
  company        String?
  location       String?
  salary         String?
  // Texto original del portal ("Remoto", "Híbrido / Remoto"…): es lo que se muestra.
  modality       String?
  // Facets canónicos para filtrar de forma confiable (el texto libre no sirve
  // como filtro). modalityTypes es multi-valor: hay avisos que ofrecen varias.
  modalityTypes  String[] @default([]) // REMOTE | HYBRID | ONSITE
  seniorityLevel String? // TRAINEE | JUNIOR | SEMI_SENIOR | SENIOR | LEAD
  postedAt       DateTime?
  descriptionRaw String        @db.Text
  // Enriquecimiento LLM (JSONB): { summary, keyRequirements[], niceToHave[],
  // skills[], seniority }
  enrichment     Json?
  raw            Json          @default("{}") // auditoría del item scrapeado
  status         VacancyStatus @default(RAW)
  matchScore     Int?
  appliedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  source   Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // Perfil "dueño" histórico (el de la fuente). El match real es N:M vía
  // VacancyProfile/MatchResult con profileId.
  profile         Profile?          @relation(fields: [profileId], references: [id], onDelete: SetNull)
  vacancyProfiles VacancyProfile[]
  matches         MatchResult[]
  drafts          ResumeDraft[]
  interviewPreps  InterviewPrep[]

  @@index([status])
  @@index([sourceId])
  @@index([profileId])
  @@index([seniorityLevel])
  // GIN para el filtro por arrays (hasSome) de modalidad.
  @@index([modalityTypes], type: Gin)
}

// ─────────────────────────────────────────────────────────────────────────────
// N:M Vacante ↔ Perfil: una vacante puede ser evaluada por varios perfiles y
// cada perfil tiene su propio estado (PENDING→MATCHED→RESUME_READY→APPLIED/IGNORED).
// ─────────────────────────────────────────────────────────────────────────────

enum VacancyProfileStatus {
  PENDING
  MATCHED
  RESUME_READY
  APPLIED
  IGNORED
}

model VacancyProfile {
  id        String               @id @default(cuid())
  vacancyId String
  profileId String
  status    VacancyProfileStatus @default(PENDING)
  appliedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, profileId])
  @@index([profileId, status])
  @@index([vacancyId, status])
}

model MatchResult {
  id        String    @id @default(cuid())
  vacancyId String
  profileId String
  // score final = blend(analysisScore, semanticScore) o analysisScore si no hay CV indexado.
  score     Int
  // Score del análisis con IA (o determinístico en modo mock).
  analysisScore Int?
  // Similitud vectorial CV↔vacante (0-100). null si el perfil no tiene CV activo.
  semanticScore Int?
  verdict   String // GOOD_MATCH | POSSIBLE | WEAK
  reasons   Json      @default("[]")
  gaps      Json      @default("[]")
  // Fórmula de aplicación (JSONB): { highlights[], keywords[], angle,
  // suggestedChannel }
  applicationStrategy Json
  coverLetterDraft     String?  @db.Text
  createdAt DateTime   @default(now())

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, profileId])
  @@index([profileId])
}

model ResumeDraft {
  id        String   @id @default(cuid())
  vacancyId String
  profileId String
  // Secciones redactadas (JSONB): [{ heading, body }] + meta
  content   Json
  format    String   @default("MARKDOWN")
  status    String   @default("DRAFT") // DRAFT | FINAL
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, profileId])
  @@index([profileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Preparación de entrevista por vacante + perfil. Se genera a pedido (botón
// "Prepararme para la entrevista") solo cuando la postulación está APPLIED.
// ─────────────────────────────────────────────────────────────────────────────

model InterviewPrep {
  id        String   @id @default(cuid())
  vacancyId String
  profileId String
  // Plan estructurado (JSONB): ver InterviewPrepContentSchema.
  content   Json
  status    String   @default("DRAFT") // DRAFT | FINAL
  source    String   @default("ia") // ia | plantilla | editada
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, profileId])
  @@index([profileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notificaciones (bandeja del dashboard; adapters email/telegram en fase 2)
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  type      String // MATCH_READY | RESUME_READY | INTERVIEW_READY | SCRAPE_ERROR | SOURCE_ERROR | INFO
  title     String
  body      String    @db.Text
  payload   Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (un solo admin para el MVP)
// ─────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
