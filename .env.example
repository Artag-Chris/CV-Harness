# ============================================================================
# cv-harness - Environment variables (raíz; la usa docker compose + el api)
# Copiá este archivo a .env y completá los valores reales. Nunca commitees .env.
#
# Secciones al estilo atiende. El api acepta REDIS_URL directo O lo deriva de
# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD (mismo patrón que atiende → podés
# reutilizar la misma Redis compartida del server).
# ============================================================================

# ── 1. APLICACIÓN ────────────────────────────────────────────────────────────
NODE_ENV=development
# Puerto del api dentro del contenedor y publicado en el host.
API_PORT=3100
# Dashboard web publicado en el host.
WEB_PORT=3001
# Postgres publicado en el host (atiende usa 5433; acá 5434).
POSTGRES_PORT=5434
# Puerto host de la Redis local (profile local-redis; adentro siempre 6379).
REDIS_HOST_PORT=6380
# Fixture E2E publicado en el host.
FIXTURE_PORT=8090
# Crea la fuente "JobsDev Fixture" habilitada en el seed (solo para E2E local).
# En el server ponelo en false: no existe ese fixture y generaría errores de scrape.
FIXTURE_ENABLED=false

# ── 2. REDIS (compartida con atiende en el server) ──────────────────────────
# En docker el hostname es "redis" (red microservices-network). Para correr el
# api nativo fuera de docker usá localhost:6379/6380 según corresponda.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Prefijo de las colas BullMQ para no pisarse con atiende (que usa atiende:dev).
QUEUE_PREFIX=cvharness

# ── 3. IA (Groq) ─────────────────────────────────────────────────────────────
# Vacía = modo mock determinístico (E2E sin red). Llenala en el server.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# auto | groq | mock
LLM_PROVIDER=auto

# ── 4. AUTH (dashboard) ──────────────────────────────────────────────────────
# Generar: openssl rand -base64 32
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@cvharness.local
ADMIN_PASSWORD=admin1234

# ── 5. SCHEDULER / PIPELINE ──────────────────────────────────────────────────
# Cada cuántos minutos corre el crawl-cycle que despacha fuentes vencidas.
CRON_INTERVAL_MINUTES=15
# Score mínimo de match para generar HV y notificar.
MATCH_MIN_SCORE=65
