# ============================================================================
# cv-harness - Environment variables (raíz; la usa docker compose + el api)
# Copiá este archivo a .env y completá los valores reales. Nunca commitees .env.
#
# Secciones al estilo atiende. El api acepta REDIS_URL directo O lo deriva de
# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD (mismo patrón que atiende → podés
# reutilizar la misma Redis compartida del server).
# ============================================================================

# ── 1. APLICACIÓN ────────────────────────────────────────────────────────────
NODE_ENV=development
# Puerto del api dentro del contenedor y publicado en el host.
API_PORT=3100
# El frontend NO se levanta acá: es la pestaña "CV Harness" del dashboard de
# atiende (proyecto dashboard/, puerto 3001 del host). No hay WEB_PORT.
# Postgres publicado en el host (atiende usa 5433; acá 5434).
POSTGRES_PORT=5434
# Puerto host de la Redis local (profile local-redis; adentro siempre 6379).
REDIS_HOST_PORT=6380
# Fixture E2E publicado en el host.
FIXTURE_PORT=8090
# FIXTURE_ENABLED=false por defecto (server): no existe el fixture E2E ahí.
# En dev local ponelo en true con el profile "fixture".
FIXTURE_ENABLED=false

# ── 2. REDIS (compartida con atiende en el server) ──────────────────────────
# En docker el hostname es "redis" (red microservices-network). Para correr el
# api nativo fuera de docker usá localhost:6379/6380 según corresponda.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Prefijo de las colas BullMQ para no pisarse con atiende (que usa atiende:dev).
QUEUE_PREFIX=cvharness

# ── 3. IA ────────────────────────────────────────────────────────────────────
# DeepSeek (IA principal; API compatible con OpenAI). Vacía = mock en auto.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Fallback opcional Groq (se usa solo si LLM_PROVIDER=groq o no hay DeepSeek en auto).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# auto | deepseek | groq | mock  (auto: deepseek > groq > mock)
LLM_PROVIDER=auto
# Embeddings de la HV y de las vacantes (igual que atiende: OpenAI; DeepSeek
# no ofrece embeddings). Vacía = embeddings mock determinísticos (E2E sin red).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=auto

# ── 4. AUTH (dashboard) ──────────────────────────────────────────────────────
# Generar: openssl rand -base64 32
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@cvharness.local
ADMIN_PASSWORD=admin1234

# ── 5. SCHEDULER / PIPELINE ──────────────────────────────────────────────────
# Cada cuántos minutos corre el crawl-cycle que despacha fuentes vencidas.
CRON_INTERVAL_MINUTES=15
# Score mínimo de match para generar HV y notificar.
MATCH_MIN_SCORE=65

# ── CHECKLIST SERVER (copiá este archivo a .env en el server) ────────────────
# 1. DEEPSEEK_API_KEY → platform.deepseek.com (IA principal)
# 2. OPENAI_API_KEY   → platform.openai.com (embeddings reales; vacío = mock)
# 3. JWT_SECRET       → el MISMO que usa atiende (login sin 2do paso)
# 4. ADMIN_PASSWORD   → cambiá admin1234
# 5. FIXTURE_ENABLED=false (queda por defecto)
# 6. REDIS_PASSWORD   → si tu Redis compartida de atiende la tiene
# Nota: docker compose espera la red microservices-network con una Redis
# llamada "redis" (la misma que usa atiende).
