# ============================================================================
# cv-harness - Environment variables (raíz; la usa docker compose + el api)
# Copiá este archivo a .env y completá los valores reales. Nunca commitees .env.
#
# Secciones al estilo atiende. El api acepta REDIS_URL directo O lo deriva de
# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD (mismo patrón que atiende → podés
# reutilizar la misma Redis compartida del server).
# ============================================================================

# ── 1. APLICACIÓN ────────────────────────────────────────────────────────────
NODE_ENV=development
# Puerto del api dentro del contenedor y publicado en el host.
API_PORT=3100
# El frontend NO se levanta acá: es la pestaña "CV Harness" del dashboard de
# atiende (proyecto dashboard/, puerto 3001 del host). No hay WEB_PORT.

# ── 2. POSTGRES / REDIS (EXTERNOS en el server — NO se crean en compose) ──────
# Postgres = el mismo de atiende (atiende-postgres, imagen pgvector) con una
# base "cvharness" propia (creala una vez). Para dev local usá:
#   DATABASE_HOST=cvharness-postgres · POSTGRES_USER=cvharness · PASSWORD=cvharness
DATABASE_HOST=atiende-postgres
DATABASE_PORT=5432
POSTGRES_USER=atiende
POSTGRES_PASSWORD=atiende_dev
POSTGRES_DB=cvharness
# Redis compartida (hostname "redis" en microservices-network). Si tenés otra,
# poné la URL completa en REDIS_URL.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Prefijo de las colas BullMQ para no pisarse con atiende (que usa atiende:dev).
QUEUE_PREFIX=cvharness

# ── Puertos LOCALES (solo docker-compose.infra.yml / fixture) ────────────────
# Postgres publicado en el host (atiende usa 5433; acá 5434).
POSTGRES_PORT=5434
# Puerto host de la Redis local.
REDIS_HOST_PORT=6380
# Fixture E2E publicado en el host.
FIXTURE_PORT=8090
# FIXTURE_ENABLED=false por defecto (server): no existe el fixture E2E ahí.
# En dev local ponelo en true con el profile "fixture".
FIXTURE_ENABLED=false

# ── 3. IA ────────────────────────────────────────────────────────────────────
# DeepSeek (IA principal; API compatible con OpenAI). Vacía = mock en auto.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Fallback opcional Groq (se usa solo si LLM_PROVIDER=groq o no hay DeepSeek en auto).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# auto | deepseek | groq | mock  (auto: deepseek > groq > mock)
LLM_PROVIDER=auto
# Embeddings de la HV y de las vacantes (igual que atiende: OpenAI; DeepSeek
# no ofrece embeddings). Vacía = embeddings mock determinísticos (E2E sin red).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=auto

# ── 4. AUTH (dashboard) ──────────────────────────────────────────────────────
# Generar: openssl rand -base64 32
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@cvharness.local
ADMIN_PASSWORD=admin1234

# ── 5. SCHEDULER / PIPELINE ──────────────────────────────────────────────────
# Cada cuántos minutos corre el crawl-cycle que despacha fuentes vencidas.
CRON_INTERVAL_MINUTES=15
# Score mínimo de match para generar HV y notificar.
MATCH_MIN_SCORE=65

# ── CHECKLIST SERVER (copiá este archivo a .env en el server) ────────────────
# 1. La base "cvharness" se crea SOLA al boot (prisma/ensure-database.ts).
#    Solo si querés crearla antes, una vez:
#      docker exec atiende-postgres psql -U atiende -c "CREATE DATABASE cvharness OWNER atiende;"
# 2. DEEPSEEK_API_KEY → platform.deepseek.com (IA principal)
# 3. OPENAI_API_KEY   → platform.openai.com (embeddings reales; vacío = mock)
# 4. JWT_SECRET       → el MISMO valor que tiene atiende EN EL SERVER (login sin
#    2do paso). Obtenelo y copialo tal cual:
#      grep '^JWT_SECRET=' /mnt/storage/LumenX/atiende/.env
#      (o: docker exec <contenedor-atiende> printenv JWT_SECRET)
#    Si no coincide, la pestaña CV del dashboard da 401 «CV Harness rechazó la sesión».
# 5. ADMIN_PASSWORD   → cambiá admin1234
# 6. FIXTURE_ENABLED=false (queda por defecto)
# 7. REDIS_PASSWORD   → si tu Redis compartida la tiene
# Nota: Redis = "redis" y Postgres = "atiende-postgres" en microservices-network.
# ⚠️ NO uses el .env de tu máquina local (apunta a cvharness-postgres).
